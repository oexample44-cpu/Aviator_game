<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aviator PRO - ADD COIN</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#0f0f13;color:#fff}
.header{background:#1a1a23;padding:10px;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #ff0040}
.bal{background:#222;padding:6px 12px;border-radius:20px;font-weight:bold;border:1px solid #333}
.add{background:#00c851;color:#fff;border:none;padding:7px 14px;border-radius:20px;font-weight:900;cursor:pointer}
.box{max-width:500px;margin:auto;padding:10px}
.hist{display:flex;gap:5px;overflow-x:auto;padding:8px 0}
.h{padding:3px 9px;border-radius:12px;font-size:11px;font-weight:bold}
.game{background:#1c1c26;border-radius:15px;height:280px;position:relative;border:2px solid #2a2a3a;margin:10px 0;overflow:hidden}
#canvas{width:100%;height:100%}
.mult{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:44px;font-weight:900}
.st{position:absolute;top:10px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,0.7);padding:4px 12px;border-radius:15px;font-size:11px}
.pl{position:absolute;font-size:26px;left:20px;bottom:30px}
.panel{background:#1c1c26;border-radius:12px;padding:12px}
.row{display:flex;gap:8px;margin:8px 0}
.row input{flex:1;background:#0f0f13;border:1px solid #333;color:#fff;padding:10px;border-radius:8px;text-align:center}
.btn{width:100%;padding:14px;border:none;border-radius:10px;font-size:16px;font-weight:900;cursor:pointer}
.modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:99;justify-content:center;align-items:center}
.modal.active{display:flex}
.mbox{background:#1c1c26;border:2px solid #ff0040;border-radius:15px;padding:20px;width:90%;max-width:340px}
.mbox input{width:100%;background:#0f0f13;border:1px solid #333;color:#fff;padding:12px;border-radius:8px;margin:8px 0}
</style>
</head>
<body>
<div class="header">
<div style="font-weight:900;color:#ff0040">AVIATOR</div>
<div style="display:flex;gap:8px;align-items:center">
<div class="bal"><span id="coinName">COIN</span>: <span id="bal">5000</span></div>
<button class="add" onclick="document.getElementById('modal').classList.add('active')">+ ADD COIN</button>
</div>
</div>
<div class="box">
<div class="hist" id="hist"></div>
<div class="game">
<canvas id="canvas"></canvas>
<div class="st" id="st">Waiting...</div>
<div class="mult" id="ml">1.00x</div>
<div class="pl" id="pl">✈️</div>
</div>
<div class="panel">
<div class="row">
<button onclick="setB(100)" style="padding:6px 10px;background:#2a2a3a;color:#fff;border:none;border-radius:6px">100</button>
<button onclick="setB(500)" style="padding:6px 10px;background:#2a2a3a;color:#fff;border:none;border-radius:6px">500</button>
<input type="number" id="bet" value="100">
</div>
<button class="btn" id="abtn" onclick="action()" style="background:#00c851;color:#fff">BET - 100 COIN</button>
</div>
</div>
<div class="modal" id="modal">
<div class="mbox">
<h3 style="color:#ff0040;text-align:center">💰 ADD COIN</h3>
<input type="text" id="cName" placeholder="Coin Name - USDT, INR, GOLD">
<input type="number" id="cAmt" placeholder="Amount - 1000">
<div style="display:flex;gap:10px;margin-top:12px">
<button onclick="document.getElementById('modal').classList.remove('active')" style="flex:1;padding:10px;background:#333;color:#fff;border:none;border-radius:8px">Cancel</button>
<button onclick="addCoin()" style="flex:1;padding:10px;background:#00c851;color:#fff;border:none;border-radius:8px">ADD</button>
</div>
</div>
</div>
